{
  "name": "nysia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm --filter @nysia/desktop dev",
    "dev:web": "pnpm --filter @nysia/web dev",
    "build": "pnpm --filter @nysia/web build",
    "build:app": "pnpm --filter @nysia/desktop build",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --if-present typecheck",
    "lint": "eslint . --max-warnings 0 && node tools/lint-meta/src/cli.ts",
    "test": "vitest run",
    "ts-drift": "node scripts/ts-drift.ts",
    "sidecar": "node scripts/sidecar.ts stage",
    "sidecar:verify": "node scripts/sidecar.ts verify",
    "prove:ts-drift": "node scripts/prove-ts-drift.ts",
    "prove:lint-meta": "node scripts/prove-lint-meta.ts",
    "prove:eslint-bans": "node scripts/prove-eslint-bans.ts",
    "prove:sidecar": "node scripts/prove-sidecar.ts",
    "prove": "pnpm prove:ts-drift && pnpm prove:lint-meta && pnpm prove:eslint-bans && pnpm prove:sidecar"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/js-yaml": "4.0.9",
    "@types/node": "22.19.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "js-yaml": "4.1.0",
    "minimatch": "9.0.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
